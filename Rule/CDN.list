# ======= Manual Rules ========
# GitHub release assets intentionally use CDN policy; broader GitHub hosts stay in Global/list-specific rules.
DOMAIN,release-assets.githubusercontent.com

# Public package CDNs
DOMAIN-SUFFIX,jsdelivr.net
DOMAIN-SUFFIX,unpkg.com
DOMAIN-SUFFIX,esm.sh
DOMAIN,cdn.statically.io
DOMAIN,cdn.cookielaw.org
DOMAIN,js-agent.newrelic.com

# Limit service matches to the domain boundary.
DOMAIN,static.grammarly.com
DOMAIN-WILDCARD,*-files.gitbook.io

# Official package, support and telemetry-agent static assets.
DOMAIN,cdnjs.cloudflare.com
DOMAIN,esm.run
DOMAIN,assets.zendesk.com
DOMAIN,static.zdassets.com
DOMAIN,web-assets.zendesk.com
DOMAIN,cdn.signalfx.com
DOMAIN,cdn.observability.splunkcloud.com

# Cloudinary public and per-project asset delivery hosts.
DOMAIN,res.cloudinary.com
DOMAIN-WILDCARD,*-res.cloudinary.com

# Retain media and asset routes within the original delivery hostname.
DOMAIN-WILDCARD,*vod-adaptive.akamaized.net
DOMAIN-WILDCARD,*-thumbs.pornhost.com
DOMAIN-WILDCARD,*-cdn.eporner.com
DOMAIN-WILDCARD,*-assets.worldsex.com
DOMAIN-WILDCARD,*-thumbs.worldsex.com
DOMAIN,cdn.adultempire.com
DOMAIN,static.trustpilot.com
DOMAIN,scripts.trustpilot.com
DOMAIN,images.trustpilot.com
DOMAIN,cdn.trustpilot.net
DOMAIN,assets.trustpilot.net
DOMAIN,images.trustpilot.net

# ======= SukkaW CDN ========
DOMAIN,cdn-msp.jmcomic.me
DOMAIN,cdn-msp.18comic.org
DOMAIN,cdn-msp.18comic.vip
DOMAIN,cdn-msp.jmcomic-zzz.one
DOMAIN-WILDCARD,cf-images.*.prod.boltdns.net

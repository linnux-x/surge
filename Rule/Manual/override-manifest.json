  "entries": [
    {
      "source_file": "AI.txt",
      "rule": "DOMAIN-SUFFIX,jina.ai",
      "reason": "真实 FINAL 流量确认其为 Jina 搜索 AI、Embedding 与 Reranker 服务",
      "destination": "AI.list",
      "route_tests": [

    {
      "source_file": "China.exclude.txt",
      "rule": "DOMAIN-KEYWORD,microsoft",
      "reason": "禁止 China 关键词把无关域名或 Microsoft 专属流量宽泛直连",
      "destination": "Microsoft_CDN、Download、Game、Microsoft 等更早专属规则，或 FINAL",
      "route_tests": [
        "notmicrosoft.example.com",
        "packages.microsoft.com",
        "microsoft.com"
      ]
    },
    {
      "source_file": "Global.exclude.txt",

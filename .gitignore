# Python
__pycache__/
*.py[cod]
*$py.class

# OS
.DS_Store
.DS_Store?
.Spotlight-V100
.Trashes
Thumbs.db

# Editor
*.swp
*.swo
*~
*.orig
audit_report.json

# Pipeline artifacts produced by workflow_dispatch runs (uploaded as an
# Actions artifact, never committed)
scripts/full_generation_manifest.sha256

# Manual rules are version-controlled so the daily CI regeneration — which runs
# without the local working tree — reproduces them instead of stripping them.
# Both append (*.txt) and exclude (*.exclude.txt) files are tracked.
Rule/Manual/*
!Rule/Manual/*.txt
!Rule/Manual/*.exclude.txt
!Rule/Manual/README.md
.codex/

#!name = Telegram跳转
#!desc = 将 https://t.me/... 重定向到你选择的客户端（tg/sg/turrit/ime/ng/lingo
#!author = b
#!category=TG跳转
#!arguments = Client:"Telegram"
#!arguments-desc = Client: Telegram/Swiftgram/Turrit/iMe/Nicegram/Lingogram 或 tg/sg/turrit/ime/ng/lingo
# 复制于 2026-11-11，除脚本地址改指本仓库外未作改动；版权归原作者，不适用本仓库的 MIT 许可证。
# 模块来源：https://raw.githubusercontent.com/Yu9191/Rewrite/main/TgRedirect.sgmodule（sha256 2a8f176f40a1cc97…）
# 脚本来源：https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/TgRedirect.js（sha256 b1cc4e493b988393…，原样复制）

[Script]
tme_redirect = type=http-request, pattern=^https?:\/\/t\.me\/.+, requires-body=0, script-path=https://raw.githubusercontent.com/linnux-x/surge/main/Module/TgRedirect.js, argument=client={{{Client}}}

[MITM]
hostname = %APPEND% t.me

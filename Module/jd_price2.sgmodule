#!name=京东比价
#!desc=京东App历史价格（商品详情页面触发）表格
#!arguments=MMMCK_SCRIPT:慢慢买CK
#!arguments-desc=[参数设置]\n1. MMMCK_SCRIPT:慢慢买CK 脚本前往慢慢买App获取Cookie\n2.避免不必要的重写，禁用请设置为"#"
# 复制于 2026-11-11，除脚本地址改指本仓库外未作改动；版权归原作者，不适用本仓库的 MIT 许可证。
# 模块来源：https://raw.githubusercontent.com/githubdulong/Script/master/Surge/jd_price2.sgmodule（sha256 8f548753c38aa8a4…）
# 脚本来源：https://raw.githubusercontent.com/wf021325/qx/master/js/jd_price.js（sha256 d6d03a94e85607a4…，原样复制）

[Script]
{{{MMMCK_SCRIPT}}} = type=http-request, pattern=^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$, script-path=https://raw.githubusercontent.com/linnux-x/surge/main/Module/jd_price.js, requires-body=true, max-size=-1, timeout=60

京东比价 = type=http-response, pattern=^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, script-path=https://raw.githubusercontent.com/linnux-x/surge/main/Module/jd_price.js, requires-body=true, max-size=-1, timeout=60


[MITM]
hostname = %APPEND% in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com